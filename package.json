    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
